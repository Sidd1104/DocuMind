# SQLite database (local file, zero setup)
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs — set to any long random string
AUTH_SECRET="replace-with-a-long-random-string"

# Primary LLM — Anthropic Claude (used for grounded answers)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Fallback LLM — used automatically if the Claude call fails or is rate-limited
GEMINI_API_KEY="..."
GEMINI_MODEL="gemini-2.0-flash"
